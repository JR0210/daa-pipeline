# Copy this file to .env and fill in values for your machine.
# Every script in this repo reads its paths/settings via daa/config.py,
# which loads this file. Nothing here should be hardcoded in the scripts.

# Root directory that holds every pipeline stage's input/output folders
# (01_raw, 02_decimated, 03_ascii, 04_aligned, 05_vtk, 06_manifests,
# 07_qc_images, 08_daa, 09_kpca, _reports). Defaults to ./meshes if unset.
DATA_ROOT=C:\path\to\your\data

# Target face count for mesh decimation.
TARGET_FACES=50000

# Path to Rscript.exe, used to invoke ascii_alignment.r from the pipeline.
# On Windows this is typically under your R installation's bin folder, e.g.
# C:\Program Files\R\R-4.4.1\bin\Rscript.exe
RSCRIPT_PATH=Rscript

# CSV of landmark coordinates used by ascii_alignment.r. Must contain a
# specimen name/ID column plus x./y./z. coordinate columns per landmark.
LANDMARKS_CSV=C:\path\to\your\data\combined_landmarks.csv

# Kernel PCA settings for kpca_generator.py.
KPCA_GAMMA=0.0000025
# Leave blank to derive n_components from the number of subjects at runtime.
KPCA_N_COMPONENTS=

# Number of parallel worker processes for CPU-bound stages (decimate, etc).
# Defaults to the machine's CPU count if unset.
JOBS=

# Comma-separated synonyms used to classify a filename as crania or
# mandible and to extract the species name preceding the token.
CRANIA_TOKENS=crania,cranium,skull
MANDIBLE_TOKENS=mandible,mandibles,jaw
